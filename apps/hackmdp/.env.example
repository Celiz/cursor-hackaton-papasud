# Base de datos (Postgres local o Supabase)
DATABASE_URL=postgresql://usuario:clave@host:5432/papasud

# Sesión
JWT_SECRET=cambiar-por-un-secreto-largo
AUTH_SECRET=cambiar-por-un-secreto-largo
ORG_SLUG=papasud

# Demo: entra derecho al panel, sin pantalla de login
DEMO_AUTOLOGIN=true
DEMO_USER_EMAIL=demo@papasud.com.ar

# Modelo de lenguaje (cliente compatible con OpenAI)
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash
# Alternativa: GROQ_API_KEY + GROQ_MODEL
