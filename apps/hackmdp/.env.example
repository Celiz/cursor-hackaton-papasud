# ── Base de datos ───────────────────────────────────────────────────────────
# Supabase de la hackathon (pedile la contraseña al equipo, no va en el repo):
#   postgresql://postgres:LA_CLAVE@db.ztqhpkchfcpespgpfmwp.supabase.co:5432/postgres
#
# OJO: ese host resuelve SOLO a IPv6 y el pooler no está habilitado en el
# proyecto. Si tu máquina no tiene salida IPv6, la conexión da timeout y parece
# contraseña equivocada, pero no lo es. Se arregla habilitando Connection
# pooling en el panel de Supabase y usando la cadena del pooler (puerto 6543).
#
# Postgres local, alternativa:
#   postgresql://postgres:postgres@localhost:5432/papasud
DATABASE_URL=

# ── Sesión ──────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-por-un-secreto-largo
AUTH_SECRET=cambiar-por-un-secreto-largo
ORG_SLUG=papasud

# Entra derecho al panel, sin pantalla de login
DEMO_AUTOLOGIN=true
DEMO_USER_EMAIL=demo@papasud.com.ar

# ── Modelo de lenguaje ──────────────────────────────────────────────────────
# Cliente compatible con OpenAI. Con OPENROUTER_API_KEY apunta a OpenRouter;
# con GROQ_API_KEY apunta a Groq.
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash
